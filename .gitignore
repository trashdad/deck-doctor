*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Next
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Generated query artifacts (rebuild with scoring/build_store.py)
data/scores.sqlite
data/scores.sqlite-shm
data/scores.sqlite-wal
data/*.faiss

# SP3 scraped decklist corpus (regenerable; sample.jsonl is the committed fixture)
data/decklists/*.jsonl
data/decklists/.seen_deck_ids
data/decklists/.recent_cursor_*
!data/decklists/sample.jsonl
tools/scrape_decklists/*.log

# SP3 corpus databases (rebuilt from the JSONL corpus by load_corpus.py)
data/decks.sqlite
data/decks.sqlite-shm
data/decks.sqlite-wal
data/edhrec.sqlite
data/edhrec.sqlite-shm
data/edhrec.sqlite-wal

# All generated SQLite stores + sidecars (regenerable; too large for git — GitHub
# rejects >100 MB). Catch-all so no built DB is ever committed again.
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal

# SP7 Commander Spellbook crawl artifacts (raw corpus + resumable cursor; the
# spellbook.sqlite above is built from these by tools/import_spellbook/).
data/spellbook_raw.jsonl
data/spellbook_state.json

# Env / editor
.env
.env.local
.DS_Store
