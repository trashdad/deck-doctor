# SP11 — backend image. Self-contained FastAPI app; data is volume-mounted, not baked in.
FROM python:3.13-slim

WORKDIR /app
# cards.json (committed, 21 MB) ships in the image so the app boots without a volume;
# the sqlite stores arrive via the mounted /app/data volume (see deploy/compose.yaml).
COPY backend/ /app/backend/
COPY data/cards.json /app/data/cards.json

RUN pip install --no-cache-dir -r /app/backend/requirements.txt

WORKDIR /app/backend
ENV SIMMANDER_CARDS=/app/data/cards.json \
    SIMMANDER_SCORES=/app/data/scores.sqlite \
    SIMMANDER_EDHREC=/app/data/edhrec.sqlite \
    SIMMANDER_SPELLBOOK=/app/data/spellbook.sqlite \
    SIMMANDER_USERDECKS=/app/userdata/userdecks.sqlite

EXPOSE 8001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
