[Unit]
Description=Deck Doctor — daily corpus refresh (scrape → load → rebuild → push → reload)
After=network-online.target deckdoctor-api.service
Wants=network-online.target
OnFailure=simmander-alert@%n.service

[Service]
Type=oneshot
User=simmander
WorkingDirectory=/opt/deck-doctor
# DATABASE_URL (same DSN as the api unit, so load_to_postgres writes the live DB)
# comes from the root-only secrets file.
EnvironmentFile=/etc/deck-doctor/secrets.env
# Combo catalogs from the simmander repo (data/combo_catalog.json, data/known_combos.json)
# -> asserted combos in card_relationships/engines. Shared data copied to the box; see
# deploy/DEPLOY.md "Combo catalogs". Missing files are logged loudly, not fatal.
Environment=COMBO_CATALOG=/var/lib/deck-doctor/combo-catalogs/combo_catalog.json
Environment=KNOWN_COMBOS=/var/lib/deck-doctor/combo-catalogs/known_combos.json
Environment=API=http://localhost:8002
# Bounded batch sizes — keep one cycle short so the daily timer never piles up.
Environment=RECENT_MAX=150
Environment=SEED_TOP=100
Environment=SEED_DECKS_PER=15
Environment=SEED_MAX_COMMANDERS=100
# The scrapers reach the public internet; allow a generous ceiling but never hang.
TimeoutStartSec=3600
ExecStart=/opt/deck-doctor/deploy/refresh_corpus.sh
