[Unit]
Description=Deck Doctor web (Next.js standalone server, basePath=/deckdoctor)
After=network.target deckdoctor-api.service

[Service]
Type=simple
User=simmander
WorkingDirectory=/opt/deck-doctor/frontend/.next/standalone
# basePath is baked at build time; the server only needs host/port. It proxies
# /deckdoctor/api/* to the backend in dev, but in prod nginx routes the API
# before it reaches Next, so BACKEND_ORIGIN is only a harmless fallback.
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
Environment=BACKEND_ORIGIN=http://127.0.0.1:8002
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
