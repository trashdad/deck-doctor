[Unit]
Description=Daily Deck Doctor card-data update (new sets flow in automatically)

[Timer]
# 02:30 UTC (+ up to 10 min): before the 03:30 DB backup and the 04:30 corpus refresh.
# Scryfall refreshes its bulk file daily. Overlaps are also excluded by the shared data
# lock (data/.pipeline.lock): the refresh waits for us, deploy.sh refuses while we run.
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=600
# Run on next boot if the box was off at 02:30.
Persistent=true

[Install]
WantedBy=timers.target
