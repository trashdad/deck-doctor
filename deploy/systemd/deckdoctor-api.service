[Unit]
Description=Deck Doctor API (FastAPI/uvicorn)
After=network.target postgresql.service
# Page the operator if the API ends up failed (restarts exhausted). Uses the
# tracker's generic alerter template (simmander-tracker docs/systemd/simmander-alert@.service).
OnFailure=simmander-alert@%n.service

[Service]
Type=simple
User=simmander
WorkingDirectory=/opt/deck-doctor/backend
# Secrets (DATABASE_URL, SIMMANDER_JWT_SECRET) live in a root-only 0600 file, not
# in this world-readable unit. See deploy/DEPLOY.md "Secrets".
EnvironmentFile=/etc/deck-doctor/secrets.env
# Card metadata is a static JSON asset; everything else lives in Postgres.
Environment=SIMMANDER_CARDS=/opt/deck-doctor/data/cards.json
# Shared login: SIMMANDER_JWT_SECRET (in secrets.env) must equal the tracker's
# backend/config.ini [auth] secret_key so the simmander_session cookie validates here.
Environment=SIMMANDER_JWT_ALG=HS256
# Browser never hits the backend directly; nginx fronts it. Bind to loopback.
ExecStart=/opt/deck-doctor/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
