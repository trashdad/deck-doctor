[Unit]
Description=Deck Doctor API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
# Adjust paths/user to match the VPS layout (mirrors the tracker's units).
User=simmander
WorkingDirectory=/opt/deck-doctor/backend
# Card metadata is a static JSON asset; everything else lives in Postgres.
Environment=SIMMANDER_CARDS=/opt/deck-doctor/data/cards.json
# The deckdoctor database — its OWN database on the shared Postgres 16 server.
# Use a strong password in prod (this is loopback-only; keep it off the public net).
Environment=DATABASE_URL=postgresql://deckdoctor:CHANGE_ME@127.0.0.1:5432/deckdoctor
# Shared login: validate the tracker's simmander_session JWT with the SAME secret
# the tracker signs with (tracker backend/config.ini [auth].secret_key). Set at
# deploy time — see DEPLOY.md §4. Anonymous browsing works without it; only
# saving/loading account decks needs a valid session.
Environment=SIMMANDER_JWT_SECRET=CHANGE_ME_TO_TRACKER_SECRET
Environment=SIMMANDER_JWT_ALG=HS256
# Browser never hits the backend directly; nginx fronts it. Bind to loopback.
ExecStart=/opt/deck-doctor/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
