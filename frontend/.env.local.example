# ---------------------------------------------------------------------------
# Affiliate link configuration
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values to earn affiliate
# commissions. Links work without any of these set — they point to bare
# product pages on ManaPool / TCGplayer with no affiliate attribution.
# ---------------------------------------------------------------------------

# ManaPool referral code (TapFiliate).
# When set, card links become: https://manapool.com/card/<slug>?ref=<value>
# and the deck-cart handoff URL becomes: https://manapool.com/add-deck?...&ref=<value>
# Example:
NEXT_PUBLIC_MANAPOOL_REF=your-manapool-ref-code

# ManaPool partner tag for the /add-deck cart handoff URL (optional).
# When set, the cart URL becomes: https://manapool.com/add-deck?partner=<value>&ref=...
# Example:
NEXT_PUBLIC_MANAPOOL_PARTNER=your-manapool-partner-tag

# TCGplayer Impact affiliate path: ACCOUNT/CAMPAIGN/AD
# When set, card links are wrapped:
#   https://tcgplayer.pxf.io/c/<value>?u=<encoded-tcgplayer-search-url>
# Without this, links go directly to the bare TCGplayer search page.
# Example:
NEXT_PUBLIC_TCGPLAYER_IMPACT=1234567/56789/0
