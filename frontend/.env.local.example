# ---------------------------------------------------------------------------
# Affiliate link configuration
# ---------------------------------------------------------------------------
# The real codes are already the built-in DEFAULTS in src/lib/affiliate.ts
# (they're public affiliate identifiers), so links carry attribution on every
# build with NO env setup. Override here only to change codes per-environment.
# Copy this file to .env.local to override.
# ---------------------------------------------------------------------------

# ManaPool referral code (TapFiliate). Default: simmander
# Card links → https://manapool.com/card/<slug>?ref=<value>
# Deck cart  → https://manapool.com/add-deck?partner=<partner>&ref=<value>
NEXT_PUBLIC_MANAPOOL_REF=simmander

# ManaPool partner tag for the /add-deck cart handoff. Default: simmander
NEXT_PUBLIC_MANAPOOL_PARTNER=simmander

# TCGplayer Impact affiliate base URL (account/campaign/ad already in the path).
# Card links wrap a search-by-name destination: <base>?u=<encoded tcgplayer search>
# Default: https://partner.tcgplayer.com/c/7268691/1780961/21018
NEXT_PUBLIC_TCGPLAYER_IMPACT=https://partner.tcgplayer.com/c/7268691/1780961/21018

# Amazon Associates tag. Default: simmander-20
# Card links → https://www.amazon.com/s?k=<name Magic The Gathering>&tag=<value>
NEXT_PUBLIC_AMAZON_TAG=simmander-20
